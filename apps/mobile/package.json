{
  "name": "@durak-master/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "predev": "fkill :8081 --force --silent",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "url": "node -e \"const os=require('os');const ip=Object.values(os.networkInterfaces()).flat().find(i=>i&&i.family==='IPv4'&&!i.internal);console.log('\\nExpo Go \u2192 exp://'+(ip?ip.address:'localhost')+':8081\\n')\"",
    "test": "vitest run"
  },
