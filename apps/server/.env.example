# DurakMaster API server — шаблон окружения.
#
# Скопировать и заполнить реальными значениями:
#   cp apps/server/.env.example apps/server/.env
#
# Одно и то же имя `.env` используется везде:
#   - локально: читается `bun dev` (см. package.json)
#   - на VPS:   загружается в контейнер (см. docker-compose.yml)
# Отличаются только ЗНАЧЕНИЯ. `.env` в gitignore; коммитится только этот шаблон.

NODE_ENV=development
PORT=4000

# Разрешённые origin'ы веб-клиента через запятую.
# Origin'ы Tauri (tauri://localhost) разрешаются автоматически — перечислять не нужно.
CORS_ORIGINS=http://localhost:3000

# --- Postgres ---
# Порт 5433 (не 5432), чтобы не конфликтовать с локально установленным Postgres.
# Эти же значения читает контейнер postgres из docker-compose.dev.yml.
POSTGRES_USER=durakmaster
POSTGRES_PASSWORD=durakmaster
POSTGRES_DB=durakmaster

DATABASE_URL=postgresql://durakmaster:durakmaster@localhost:5433/durakmaster?schema=public
DIRECT_URL=postgresql://durakmaster:durakmaster@localhost:5433/durakmaster?schema=public

# --- Valkey / Redis ---
# Директория столов (roomId → нода), pub/sub и лог реконнекта.
REDIS_URL=redis://localhost:6379

# --- Auth (better-auth) ---
# Секрет для подписи токенов. Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# --- Игровой узел ---
# Идентификатор процесса, владеющего столами. Должен быть уникален в кластере.
NODE_ID=node-local
# Адрес, по которому клиент подключается к ЭТОЙ ноде после резервирования места.
NODE_PUBLIC_URL=ws://localhost:4000

# --- SMTP (локально — mailpit, UI на http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@durakmaster.com

# --- Push (FCM) ---
# Путь к service account JSON либо его содержимое в base64.
FIREBASE_SERVICE_ACCOUNT=
