// Схема БД DurakMaster.
//
// Стартовый срез: аутентификация (better-auth), профиль с двумя валютами,
// столы и история партий. Экономика, клубы и античит-логи
// добавляются отдельными миграциями по мере проработки спеков.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// В Prisma 7 строки подключения задаются в prisma.config.ts, а не здесь.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// better-auth
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  profile      Profile?
  seats        TableSeat[]
  gamePlayers  GamePlayer[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  issuer                String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Профиль и экономика
// ---------------------------------------------------------------------------

model Profile {
  id     String @id @default(cuid())
  userId String @unique

  // Мягкая валюта — ставки за столами.
  credits BigInt @default(1450)
  // Твёрдая валюта — покупается за деньги. Не переводится между игроками:
  // переводы создают серый рынок и риск переклассификации в азартную игру.
  coins   Int    @default(15)

  rating       Int      @default(0)
  gamesPlayed  Int      @default(0)
  gamesWon     Int      @default(0)
  gamesLost    Int      @default(0)
  premiumUntil DateTime?

  lastFreeCreditsAt DateTime?
  lastLoginAt       DateTime?
  loginStreak       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile")
}

// ---------------------------------------------------------------------------
// Столы и партии
// ---------------------------------------------------------------------------

enum GameMode {
  THROW_IN
  TRANSFER
}

enum TableStatus {
  WAITING
  PLAYING
  FINISHED
}

model GameTable {
  id     String      @id @default(cuid())
  status TableStatus @default(WAITING)

  mode       GameMode @default(THROW_IN)
  deckSize   Int      @default(36)
  maxPlayers Int      @default(4)
  bet        BigInt   @default(100)

  allowDraw   Boolean @default(true)
  isPrivate   Boolean @default(false)
  passwordHash String?

  // Нода, владеющая состоянием стола. Пусто — стол не размещён.
  nodeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seats TableSeat[]
  games Game[]

  @@index([status, isPrivate])
  @@index([nodeId])
  @@map("game_table")
}

model TableSeat {
  id      String @id @default(cuid())
  tableId String
  userId  String
  seat    Int

  joinedAt DateTime @default(now())

  table GameTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tableId, seat])
  @@unique([tableId, userId])
  @@index([userId])
  @@map("table_seat")
}

model Game {
  id      String @id @default(cuid())
  tableId String

  mode     GameMode
  deckSize Int
  trump    String
  bet      BigInt

  // Снапшот состояния на границе хода — для восстановления после рестарта.
  snapshot Json?
  version  Int   @default(0)

  loserUserId String?
  isDraw      Boolean @default(false)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  table   GameTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  players GamePlayer[]

  @@index([tableId])
  @@index([finishedAt])
  @@map("game")
}

model GamePlayer {
  id     String @id @default(cuid())
  gameId String
  userId String
  seat   Int

  // Изменение баланса по итогу партии: положительное — выигрыш.
  creditsDelta BigInt @default(0)
  ratingDelta  Int    @default(0)
  isLoser      Boolean @default(false)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, seat])
  @@index([userId])
  @@map("game_player")
}
