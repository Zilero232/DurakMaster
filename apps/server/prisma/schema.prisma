// DurakMaster database schema.
//
// This file holds only the generator and the datasource; the models live in
// `models/`, split by domain. `prisma.config.ts` points at this folder, and
// Prisma loads every `.prisma` file under it as one schema.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// In Prisma 7 connection strings live in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}
