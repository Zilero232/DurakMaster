// Friends and the invitations they send each other.

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

/**
 * One row per pair, not two.
 * `requester` is whoever sent the request and `addressee` whoever received it;
 * only the addressee may accept. The unique index is on the ordered pair, so a
 * second request in the opposite direction is rejected by the database rather
 * than by application code that could forget to check.
 */
model Friendship {
  id String @id @default(cuid())

  requesterId String
  addresseeId String

  status FriendshipStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  acceptedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendship")
}
