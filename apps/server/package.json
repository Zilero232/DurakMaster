{
  "name": "@durak-master/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "fkill :4000 --force --silent",
    "dev": "bun --hot --cwd ../.. --env-file .env apps/server/src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist --packages external",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:reset": "prisma migrate reset",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@durak-master/game-core": "workspace:*",
    "@durak-master/schemas": "workspace:*",
    "@nestjs/common": "12",
    "@nestjs/config": "12",
    "@nestjs/core": "12",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-ws": "12",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/websockets": "12",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.2",
    "express": "5.2.1",
    "file-type": "^22.0.2",
    "helmet": "8.3.0",
    "nestjs-pino": "4.6.1",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "rate-limiter-flexible": "^11.2.0",
    "reflect-metadata": "0.2.2",
    "remeda": "^2.39.0",
    "rxjs": "7.8.2",
    "ts-pattern": "^5.9.0",
    "ws": "8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "typescript": "6.0.3"
  }
}
