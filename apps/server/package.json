{
  "name": "@durak-master/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "fkill :4000 --force --silent",
    "dev": "bun --hot --cwd ../.. --env-file .env apps/server/src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist --packages external",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:reset": "prisma migrate reset",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@durak-master/game-core": "workspace:*",
    "@durak-master/schemas": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-ws": "11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.28",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@react-email/render": "^2.1.0",
    "@sentry/nestjs": "^10.68.0",
    "@thallesp/nestjs-better-auth": "2.7.0",
    "better-auth": "^1.7.1",
    "bullmq": "^5.81.2",
    "date-fns": "^4.4.0",
    "express": "5.2.1",
    "firebase-admin": "^14.1.0",
    "helmet": "8.3.0",
    "ioredis": "^5.9.0",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.4.0",
    "nodemailer": "^9.0.3",
    "obscenity": "^0.4.6",
    "openskill": "^5.0.1",
    "pg": "^8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "posthog-node": "^5.46.1",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "reflect-metadata": "0.2.2",
    "remeda": "^2.39.0",
    "rxjs": "7.8.2",
    "ts-pattern": "^5.9.0",
    "ws": "8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.0",
    "typescript": "~6.0.3"
  }
}
