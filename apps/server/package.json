{
  "name": "@durak-master/server",
  "version": "0.0.0",
  "description": "NestJS API and the WebSocket gateway that owns every table",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "fkill :4000 --force --silent",
    "dev": "bun --hot --cwd ../.. --env-file .env apps/server/src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist --packages external",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:reset": "prisma migrate reset",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@durak-master/game-core": "workspace:*",
    "@durak-master/schemas": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-ws": "^12.1.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/websockets": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "1.7.7",
    "date-fns": "^4.4.0",
    "express": "5.3.0",
    "file-type": "^22.1.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "neverthrow": "^8.2.0",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "reflect-metadata": "0.2.2",
    "remeda": "^2.51.0",
    "rxjs": "7.8.2",
    "ts-pattern": "^5.9.0",
    "ws": "8.22.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.7",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "typescript": "6.0.3"
  }
}
