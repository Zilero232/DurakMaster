# DurakMaster web client — шаблон окружения.
#
# Скопировать и заполнить:
#   cp apps/client/.env.example apps/client/.env
#
# Переменные с префиксом NEXT_PUBLIC_ попадают в бандл и видны в браузере.
# Секреты сюда класть нельзя — только публичные адреса и флаги.

# --- API ---
# HTTP-адрес бэкенда. Локально сервер слушает 4000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket-адрес игрового шлюза.
# Если не задан, клиент собирает его из текущего хоста и порта 4000.
# Продакшен: wss://api.durakmaster.com/ws
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# --- Аналитика (необязательно) ---
# Пусто — аналитика выключена.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Отслеживание ошибок (необязательно) ---
NEXT_PUBLIC_SENTRY_DSN=
