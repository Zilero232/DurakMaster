{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DurakMaster",
  "version": "0.1.0",
  "identifier": "ru.durakmaster.app",
  "build": {
    "frontendDist": "../client/out",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun --filter @durak-master/client build",
    "beforeDevCommand": "bun --filter @durak-master/client dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DurakMaster",
        "width": 1100,
        "height": 760,
        "center": true,
        "minWidth": 380,
        "minHeight": 600,
        "backgroundColor": "#151a24",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Онлайн-дурак",
    "longDescription": "DurakMaster — онлайн-дурак: подкидной и переводной, столы на 2–6 игроков.",
    "copyright": "Copyright © 2026 DurakMaster",
    "publisher": "DurakMaster",
    "license": "MIT",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["durakmaster"]
      },
      "mobile": [
        {
          "scheme": ["durakmaster"]
        }
      ]
    }
  }
}
