{
  "name": "durak-master",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:server": "bun --filter @durak-master/server dev",
    "dev:mobile": "bun --filter @durak-master/mobile dev",
    "android": "bun --filter @durak-master/mobile android",
    "ios": "bun --filter @durak-master/mobile ios",
    "web": "bun --filter @durak-master/mobile web",
    "prebuild": "bun --filter @durak-master/mobile prebuild",
    "build": "bun --filter @durak-master/server build && bun --filter @durak-master/mobile build:web",
    "verify": "bun run typecheck && bun run test && bun run lint && bun run lint:fsd && bun run format:check",
    "fix": "bun run lint:fix && bun run format",
    "typecheck": "bun --filter @durak-master/schemas typecheck && bun --filter @durak-master/game-core typecheck && bun --filter @durak-master/platform typecheck && bun --filter @durak-master/server typecheck && bun --filter @durak-master/mobile typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:fsd": "steiger ./apps/mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:shots": "cross-env E2E_SHOTS=1 playwright test e2e/screenshots.spec.ts"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@playwright/test": "^1.62.1",
    "@siberiacancode/eslint": "^2.18.1",
    "@siberiacancode/prettier": "^1.9.0",
    "@siberiacancode/tsconfig": "^1.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "fkill-cli": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "steiger": "^0.6.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
