{
  "name": "durak-master",
  "version": "1.0.0",
  "description": "Online Durak — throw-in and transfer variants, 2-6 players, for Android and iOS",
  "author": "Alexandr Artemev <zilero@dev.ru>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/DurakMaster.git"
  },
  "engines": {
    "bun": ">=1.3.1"
  },
  "packageManager": "bun@1.3.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "bun --filter @durak-master/server --filter @durak-master/mobile --parallel dev",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:server": "bun --filter @durak-master/server dev",
    "dev:mobile": "bun run --cwd apps/mobile dev",
    "android": "bun run --cwd apps/mobile android",
    "ios": "bun run --cwd apps/mobile ios",
    "build": "bun --filter @durak-master/server build",
    "prebuild": "bun run --cwd apps/mobile prebuild",
    "verify": "bun run typecheck && bun run test && bun run lint && bun run lint:fsd && bun run format:check",
    "fix": "bun run lint:fix && bun run format",
    "typecheck": "bun --filter @durak-master/schemas typecheck && bun --filter @durak-master/game-core typecheck && bun --filter @durak-master/server typecheck && bun --filter @durak-master/mobile typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:fsd": "steiger ./apps/mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "commit": "cz",
    "commitlint": "commitlint --from origin/main"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@siberiacancode/eslint": "^2.18.1",
    "@siberiacancode/prettier": "^1.9.0",
    "@siberiacancode/tsconfig": "^1.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "eslint": "^10.12.0",
    "fkill-cli": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "steiger": "^0.7.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "zod": "4.6.6"
  }
}
