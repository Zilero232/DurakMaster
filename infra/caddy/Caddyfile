# DurakMaster — Caddy config (runs on the VPS).
#
# Caddy is the only container published to the internet: it terminates HTTPS
# and proxies api.durakmaster.ru to the NestJS API and its WebSocket gateway.
#
# Caddy obtains and renews a Let's Encrypt certificate automatically. For that:
#   - the A-record for api.durakmaster.ru points at this VPS
#   - ports 80 and 443 are open on the firewall

api.durakmaster.ru {
	# The server container is not published to the host: it is reachable only
	# inside the compose network, by service name.

	# The game runs over this socket. Caddy upgrades it automatically, but the
	# connection must never be buffered or compressed.
	@ws path /ws*
	reverse_proxy @ws server:4000 {
		flush_interval -1
	}

	reverse_proxy server:4000

	@compressible not path /ws*
	encode @compressible gzip zstd

	log {
		output stdout
		format console
	}
}
